# ComplianceShield — environment variables (both tracks)
# Copy to .env and fill in. Never commit the real .env file.

# --- /service (Phases 1-3) ---
# None required yet — Phase 3's delivery wrapper is a local-only CLI/form,
# no external services in scope for the service track.

# --- /platform (Phases 4-7) ---

# Postgres (Phase 4 backend + Phase 5 pgvector store)
DATABASE_URL=postgresql://user:password@localhost:5432/complianceshield

# Anthropic API (Phase 5 RAG pipeline)
ANTHROPIC_API_KEY=

# Auth (Phase 7 — roll-your-own JWT, see Playbook Section 0.5)
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Billing (Phase 7 — Stripe, sandbox mode until real client)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_QUARTERLY=

# Frontend (Phase 6 — Next.js, points at the Phase 4 backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deployment (Phase 9) ---
# Placeholder domain per Playbook Section 0.5 — replace before go-live
COMPLIANCESHIELD_DOMAIN=compliance-shield.com
COMPLIANCESHIELD_CONTACT_EMAIL=hello@compliance-shield.com
