# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (classification step) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-sonnet-4-6

# --- Quiver Quantitative (Congress trades) ---
# Free tier is fine to start — see CLAUDE.md defaults table.
QUIVER_API_KEY=

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent identifying the requester.
EDGAR_USER_AGENT=SignalForge you@example.com

# --- Google Sheets logging ---
# Path to a service-account JSON key file with edit access to the target sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Events

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twitter/X (social collector — added after Phase 1) ---
# Bearer token from a developer.x.com app (app-only auth, recent-search endpoint).
TWITTER_BEARER_TOKEN=
# Optional: override the default search query.
TWITTER_SEARCH_QUERY=
GOOGLE_SHEET_TAB_TWITTER=X

# --- Reddit (social collector — added after Phase 1) ---
# From a "script" app at reddit.com/prefs/apps — client_credentials grant, no user login needed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent, same spirit as EDGAR_USER_AGENT above.
REDDIT_USER_AGENT=SignalForge/0.1 by YOUR_REDDIT_USERNAME
REDDIT_SEARCH_QUERY=
GOOGLE_SHEET_TAB_REDDIT=Reddit

# --- Press wires (free RSS — added post-Phase-1, no API key required) ---
PRESS_WIRE_USER_AGENT=SignalForge you@example.com
